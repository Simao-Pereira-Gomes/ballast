{
  "name": "@ballast/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env node_modules/vite/bin/vite.js dev",
    "build": "vite build",
    "start": "HOST=${HOST:-127.0.0.1} node --env-file-if-exists=../../.env .output/server/index.mjs",
    "typecheck": "tsc -p .",
    "test": "vitest run --project unit --passWithNoTests",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vite build && playwright test",
    "db:migrate": "node --env-file-if-exists=../../.env src/server/migrate-cli.ts"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@ballast/core": "workspace:*",
    "@effect/platform-node": "4.1.1",
    "@effect/sql-pg": "4.1.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "effect": "4.1.1",
    "nitro": "3.0.261029-rc",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
